;; shadow-cljs configuration
{:source-paths
 ["src/dev"
  "src/main"
  "src/test"]

 :dependencies
 [[reagent "1.3.0"]
  [cljsjs/react "18.3.1-1"]
  [cljsjs/react-dom "18.3.1-1"]]

 :dev-http
 {8020 "resources/public"}

 :builds
 {:app
  {:target :browser
   :output-dir "resources/public/js"
   :asset-path "/js"

   :devtools {:before-load starter.browser/start
              :after-load starter.browser/stop}

   :modules
   {:main ; becomes resources/public/js/main.js
    {:init-fn starter.browser/init}}}}}
